<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.codemonstur</groupId>
    <artifactId>htmlcompiler</artifactId>
    <version>5.8.0</version>
    <packaging>maven-plugin</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>An HTML compiler, with maven plugin</description>
    <url>https://github.com/codemonstur/HTMLCompiler</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/codemonstur/HTMLCompiler.git</connection>
        <developerConnection>scm:git:https://github.com/codemonstur/HTMLCompiler.git</developerConnection>
        <url>https://github.com/codemonstur/HTMLCompiler</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>codemonstur</id>
            <name>Jurgen Voorneveld</name>
            <email>jegvoorneveld@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.version>3.6.3</maven.version>

        <version.library.bobthebuildtool>12</version.library.bobthebuildtool>
        <version.library.jsoup>1.23.2</version.library.jsoup>
        <version.library.gson>2.14.0</version.library.gson>
        <version.library.common-io>2.22.0</version.library.common-io>
        <version.library.commons-lang3>3.21.0</version.library.commons-lang3>
        <version.library.commons-text>1.15.0</version.library.commons-text>
        <version.library.yuicompressor>2.4.8</version.library.yuicompressor>
        <version.library.htmlcompressor>2.4.1</version.library.htmlcompressor>
        <version.library.jlessc>1.16</version.library.jlessc>
        <version.library.jfiveparse>2.1.1</version.library.jfiveparse>
        <version.library.vaadin-sass>0.9.13</version.library.vaadin-sass>
        <version.library.pebble>4.1.2</version.library.pebble>
        <version.library.jade4j>1.3.2</version.library.jade4j>
        <!-- Newer versions don't work: https://github.com/neuland/pug4j/issues/29 -->
        <version.library.pug4j>2.0.4</version.library.pug4j>
        <version.library.simplexml>3.6.0</version.library.simplexml>
        <version.library.closure-compiler>v20261005</version.library.closure-compiler>
        <version.library.minifier>1.5</version.library.minifier>
        <version.library.maven>3.9.16</version.library.maven>
        <version.library.maven-annotations>3.16.0</version.library.maven-annotations>
        <version.library.cssparser>0.9.30</version.library.cssparser>
        <version.library.junit>6.1.3</version.library.junit>

        <version.plugin.gpg>3.2.8</version.plugin.gpg>
        <version.plugin.surefire>3.6.0</version.plugin.surefire>
        <version.plugin.plugin>3.16.0</version.plugin.plugin>
        <version.plugin.publish>0.12.0</version.plugin.publish>
        <version.plugin.source>3.4.0</version.plugin.source>
        <version.plugin.shade>3.6.0</version.plugin.shade>
        <version.plugin.javadoc>3.12.0</version.plugin.javadoc>
        <version.plugin.check-cves>1.1.0</version.plugin.check-cves>
        <version.plugin.codegrade>0.2.0</version.plugin.codegrade>
        <version.plugin.license-check>1.3.0</version.plugin.license-check>
        <version.plugin.enforcer>3.6.3</version.plugin.enforcer>

    </properties>

    <build>
        <finalName>${project.artifactId}</finalName>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${version.plugin.enforcer}</version>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${maven.version}</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.plugin.surefire}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${version.plugin.plugin}</version>
                <configuration>
                    <goalPrefix>hc:</goalPrefix>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${version.plugin.source}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${version.plugin.javadoc}</version>
                                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>deploy</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Builds the self-contained jar that bob loads as a plugin; it is attached
                 with the classifier 'bobplugin' and uploaded to the Github release. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${version.plugin.shade}</version>
                <executions>
                    <execution>
                        <id>bobplugin</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>bobplugin</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Bob-Plugin-Class>htmlcompiler.BobPlugin</Bob-Plugin-Class>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <minimizeJar>false</minimizeJar>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${version.plugin.gpg}</version>
                <configuration>
                    <passphrase>${gpg.passphrase}</passphrase>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${version.plugin.publish}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${version.library.jsoup}</version>
        </dependency>
        <dependency>
            <groupId>ch.digitalfondue.jfiveparse</groupId>
            <artifactId>jfiveparse</artifactId>
            <version>${version.library.jfiveparse}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${version.library.gson}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${version.library.common-io}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${version.library.commons-lang3}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>${version.library.commons-text}</version>
        </dependency>
        <dependency>
            <groupId>com.yahoo.platform.yui</groupId>
            <artifactId>yuicompressor</artifactId>
            <version>${version.library.yuicompressor}</version>
        </dependency>
        <dependency>
            <groupId>com.github.hazendaz</groupId>
            <artifactId>htmlcompressor</artifactId>
            <version>${version.library.htmlcompressor}</version>
        </dependency>
        <dependency>
            <groupId>de.inetsoftware</groupId>
            <artifactId>jlessc</artifactId>
            <version>${version.library.jlessc}</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-sass-compiler</artifactId>
            <version>${version.library.vaadin-sass}</version>
        </dependency>
        <dependency>
            <groupId>io.pebbletemplates</groupId>
            <artifactId>pebble</artifactId>
            <version>${version.library.pebble}</version>
        </dependency>
        <dependency>
            <groupId>de.neuland-bfi</groupId>
            <artifactId>jade4j</artifactId>
            <version>${version.library.jade4j}</version>
        </dependency>
        <dependency>
            <groupId>de.neuland-bfi</groupId>
            <artifactId>pug4j</artifactId>
            <version>${version.library.pug4j}</version>
        </dependency>
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>simplexml</artifactId>
            <version>${version.library.simplexml}</version>
        </dependency>
        <dependency>
            <groupId>com.google.javascript</groupId>
            <artifactId>closure-compiler</artifactId>
            <version>${version.library.closure-compiler}</version>
        </dependency>
        <dependency>
            <groupId>net.logicsquad</groupId>
            <artifactId>minifier</artifactId>
            <version>${version.library.minifier}</version>
        </dependency>

        <!--  Only needed to compile the bob plugin integration, never shipped  -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>bobthebuildtool</artifactId>
            <version>${version.library.bobthebuildtool}</version>
            <scope>provided</scope>
        </dependency>

        <!--  For Maven plugin  -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${version.library.maven}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${version.library.maven}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${version.library.maven-annotations}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.sourceforge.cssparser</groupId>
            <artifactId>cssparser</artifactId>
            <version>${version.library.cssparser}</version>
            <scope>test</scope>
        </dependency>
<!--        <dependency>-->
<!--            <groupId>com.helger</groupId>-->
<!--            <artifactId>ph-css</artifactId>-->
<!--            <version>6.3.4</version>-->
<!--            <scope>test</scope>-->
<!--        </dependency>-->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.library.junit}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
        <groupId>org.junit.vintage</groupId>
        <artifactId>junit-vintage-engine</artifactId>
        <version>6.1.3</version>
        <scope>test</scope>
    </dependency>
</dependencies>

    <profiles>

        <profile>
            <id>licenses</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-license</artifactId>
                        <version>${version.plugin.license-check}</version>
                        <executions>
                            <execution><goals><goal>check</goal></goals></execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                            <rules>
                                <rule>name:equal:BSD License</rule>
                                <rule>url:equal:http://www.opensource.org/licenses/bsd-license.php</rule>
                                <rule>url:regex:(http|https)://opensource.org/licenses/BSD-(2|3)-Clause</rule>
                                <rule>url:regex:(http|https)://(www.)?opensource.org/licenses/(MIT|mit-license.php)</rule>
                                <rule>name:equal:The MIT License</rule>
                                <rule>name:regex:(The )?Apache(\s|-)(Software )?(License |License, )?(Version |version )?2\.0</rule>
                                <rule>url:equal:http://www.eclipse.org/org/documents/edl-v10.php</rule>
                                <rule>name:equal:Eclipse Public License v2.0</rule>
                                <rule>url:equal:https://opensource.org/license/mit</rule>
                                <rule>url:equal:http://www.gnu.org/licenses/lgpl.html</rule>
                                <rule>url:equal:http://www.w3.org/Consortium/Legal/copyright-software-19980720</rule>
                                <rule>url:equal:http://openjdk.java.net/legal/gplv2+ce.html</rule>
                                <rule>url:equal:https://raw.githubusercontent.com/unicode-org/icu/master/icu4c/LICENSE</rule>
                                <rule>url:equal:http://www.mozilla.org/MPL/MPL-1.1.html</rule>
                                <rule>url:equal:http://www.mozilla.org/MPL/2.0/</rule>
                                <rule>url:equal:http://opensource.org/licenses/UPL</rule>
                            </rules>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>vulnerabilities</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-cves</artifactId>
                        <version>${version.plugin.check-cves}</version>
                        <executions>
                            <execution><goals><goal>check</goal></goals></execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>codequality</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>codegrade-maven-plugin</artifactId>
                        <version>${version.plugin.codegrade}</version>
                        <executions>
                            <execution><goals><goal>check</goal></goals></execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>