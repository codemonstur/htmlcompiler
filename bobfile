include https://raw.githubusercontent.com/codemonstur/bobfiles/master/foss-lib-github-maven

vendor: com.github.codemonstur
name: htmlcompiler
version: 5.8.0
description: An HTML compiler, with maven plugin
license:
  name: MIT
developer:
  name: Jurgen Voorneveld
  email: jegvoorneveld@gmail.com
enablePreview: false
packaging: maven-plugin
dependencies:
  - repository: org.jsoup:jsoup:1.23.2
  - repository: com.google.code.gson:gson:2.15.0
  - repository: commons-io:commons-io:2.22.0
  - repository: io.pebbletemplates:pebble:4.1.2
  - repository: com.github.hazendaz:htmlcompressor:2.4.1
  - repository: com.yahoo.platform.yui:yuicompressor:2.4.8
  - repository: com.google.javascript:closure-compiler:v20261021
  - repository: de.inetsoftware:jlessc:1.16
  - repository: com.vaadin:vaadin-sass-compiler:0.9.13
  - repository: de.neuland-bfi:jade4j:1.3.2
  # This library doesn't work, but bob fails to load the older version (2.0.4) because its pom is invalid
  - repository: de.neuland-bfi:pug4j:3.1.1
  - repository: com.github.codemonstur:simplexml:3.6.0
  - repository: org.apache.maven:maven-core:3.10.0
    scope: provided
  - repository: org.apache.maven:maven-plugin-api:3.10.0
    scope: provided
  - repository: org.apache.maven.plugin-tools:maven-plugin-annotations:3.16.0
    scope: provided
  - repository: org.apache.maven:maven-project:3.0-alpha-2
    scope: provided
#  - repository: com.helger:ph-css:6.3.0
#    scope: test
  - repository: net.sourceforge.cssparser:cssparser:0.9.30
    scope: test
  - repository: org.junit.jupiter:junit-jupiter:6.1.3
    scope: test

build
 |  mvn clean package -DskipTests

-- Uploads binaries to Github; the bobplugin jar is what the bob `plugin` directive downloads
deploy-github
    info [${PROJECT_NAME}] Uploading to Github
    hub release create -a target/${PROJECT_NAME}-${PROJECT_VERSION}-bobplugin.jar -F src/docs/releases/release-${PROJECT_VERSION}.txt ${PROJECT_NAME}-${PROJECT_VERSION}
